rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['nickname', 'score', 'stars', 'accuracy', 'maxCombo', 'levelsCleared', 'badgeTitle', 'createdAt']) &&
        data.keys().hasOnly(['nickname', 'score', 'stars', 'accuracy', 'maxCombo', 'levelsCleared', 'badgeTitle', 'createdAt']) &&
        data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 30 &&
        data.score is number && data.score >= 0 && data.score <= 100000 &&
        data.stars is number && data.stars >= 1 && data.stars <= 3 &&
        data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
        data.maxCombo is number && data.maxCombo >= 0 && data.maxCombo <= 50 &&
        data.levelsCleared is number && data.levelsCleared >= 1 && data.levelsCleared <= 5 &&
        data.badgeTitle is string && data.badgeTitle.size() <= 50 &&
        (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Leaderboard Collection
    match /leaderboard/{entryId} {
      // Any student can view the public leaderboard in real time
      allow read, list: if true;

      // Allow creating valid new completion records
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);

      // Records are immutable once posted
      allow update, delete: if false;
    }
  }
}
